# Grafana MCP (local OSS) — copy values into ~/.cursor/mcp.json after stack is up.
#
# 1. Start stack: docker compose -f monitoring/docker-compose.yml up -d
# 2. Open http://localhost:3001 (admin / see docker-compose for password)
# 3. Administration → Service accounts → Add service account (Role: Admin)
# 4. Add token → copy into ~/.cursor/mcp.json → grafana.env.GRAFANA_SERVICE_ACCOUNT_TOKEN
# 5. Reload Cursor MCP (restart or MCP panel refresh)

GRAFANA_URL=http://localhost:3001
GRAFANA_SERVICE_ACCOUNT_TOKEN=REPLACE_ME
