      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 120 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "YES/NO Deviation Over Time",
      "gridPos": { "x": 12, "y": 39, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_polymarket_yes_no_deviation{service=\"market-data-platform-converter\"}",
          "legendFormat": "deviation",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Implied Prob (Up) Over Time",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_polymarket_implied_prob_up{service=\"market-data-platform-converter\"}",
          "legendFormat": "implied prob (Up)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "PM–Perp Divergence (Cross-Venue)",
      "gridPos": { "x": 0, "y": 47, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 22,
      "type": "stat",
      "title": "PM–Perp Divergence",
