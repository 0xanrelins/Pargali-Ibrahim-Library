    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "PM–Perp Divergence Over Time",
      "gridPos": { "x": 12, "y": 52, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_cross_pm_perp_divergence{service=\"market-data-platform-converter\"}",
