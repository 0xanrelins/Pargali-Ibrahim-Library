          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Dataset"
          }
        ]
      },
      "pluginVersion": "11.5.2",
      "targets": [
        {
          "expr": "label_join(mdp_catalog_dataset_rows{category=~\"$category\"}, \"dataset\", \"/\", \"category\", \"symbol\")",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "expr": "label_join(mdp_catalog_dataset_files{category=~\"$category\"}, \"dataset\", \"/\", \"category\", \"symbol\")",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Datasets",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "dataset",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "category": true,
              "category 1": true,
              "category 2": true,
              "dataset_id": true,
              "instance": true,
              "job": true,
              "service": true,
              "symbol": true,
              "symbol 1": true,
              "symbol 2": true
            },
            "indexByName": {
              "Parquet Files": 2,
              "Rows": 1,
              "dataset": 0
            },
            "renameByName": {
              "Value #A": "Rows",
              "Value #B": "Parquet Files",
              "dataset": "Dataset"
            }
          }
        }
      ],
      "type": "table"
    },
