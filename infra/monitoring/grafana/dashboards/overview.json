      "id": 13,
      "type": "timeseries",
      "title": "Pipeline Activity",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(mdp_pipeline_raw_files_written_total{service=~\"market-data-platform-(collector|orderbook|polymarket)\"}[5m]))",
          "legendFormat": "raw files/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(mdp_pipeline_raw_bytes_written_total{service=~\"market-data-platform-(collector|orderbook|polymarket)\"}[5m]))",
          "legendFormat": "raw bytes/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "raw bytes/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      }
