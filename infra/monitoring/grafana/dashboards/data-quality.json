{
  "uid": "mdp-data-quality",
  "title": "Market Data Platform — Data Quality",
  "tags": ["market-data-platform", "phase-3", "quality"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "category",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(mdp_quality_score, category)", "refId": "A" },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "trades", "value": "trades" }
      },
      {
        "name": "symbol",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(mdp_quality_score{category=\"$category\"}, symbol)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "BTCUSDT", "value": "BTCUSDT" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Quality Summary",
      "description": "Quality score and rows validated for all datasets.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "label_join(mdp_quality_score, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "label_join(mdp_quality_rows_validated, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "dataset", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "service": true,
              "category": true,
              "symbol": true,
              "category 1": true,
              "category 2": true,
              "symbol 1": true,
              "symbol 2": true
            },
            "indexByName": {
              "dataset": 0,
              "Quality Score": 1,
              "Rows Validated": 2
            },
            "renameByName": {
              "Value #A": "Quality Score",
              "Value #B": "Rows Validated",
              "dataset": "Dataset"
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Quality Score" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 95 },
                    { "color": "green", "value": 99 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Rows Validated" },
            "properties": [{ "id": "decimals", "value": 0 }]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Quality Score", "desc": false }] }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Quality Score — $category / $symbol",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_quality_score{category=\"$category\", symbol=\"$symbol\"}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rows Validated",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_quality_rows_validated{category=\"$category\", symbol=\"$symbol\"}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Failures",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(mdp_quality_validation_failures{category=\"$category\", symbol=\"$symbol\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Validation Failures — $category / $symbol",
      "description": "Failure count per check for the selected dataset.",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_quality_validation_failures{category=\"$category\", symbol=\"$symbol\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "category": true,
              "instance": true,
              "job": true,
              "service": true,
              "symbol": true
            },
            "renameByName": { "Value": "Failures", "check": "Check" }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Failures", "desc": true }] } }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failures" },
            "properties": [
              { "id": "decimals", "value": 0 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "red", "value": 100 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 6,
      "type": "table",
      "title": "All Validation Failures",
      "description": "Datasets with at least one validation failure.",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "label_join(mdp_quality_validation_failures > 0, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "category": true,
              "instance": true,
              "job": true,
              "service": true,
              "symbol": true
            },
            "renameByName": { "Value": "Failures", "check": "Check", "dataset": "Dataset" }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Failures", "desc": true }] } }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failures" },
            "properties": [{ "id": "decimals", "value": 0 }]
          }
        ]
      },
      "options": { "showHeader": true }
    }
  ],
  "annotations": { "list": [] }
}
