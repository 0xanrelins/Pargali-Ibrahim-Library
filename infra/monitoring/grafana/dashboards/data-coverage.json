{
  "uid": "mdp-data-coverage",
  "title": "Market Data Platform — Data Coverage",
  "tags": ["market-data-platform", "phase-3", "coverage"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "category",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(mdp_coverage_percent, category)", "refId": "A" },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "trades", "value": "trades" }
      },
      {
        "name": "symbol",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(mdp_coverage_percent{category=\"$category\"}, symbol)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "BTCUSDT", "value": "BTCUSDT" }
      },
      {
        "name": "day",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(mdp_coverage_day_present{category=\"$category\", symbol=\"$symbol\"}, day)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Coverage Summary",
      "description": "All datasets — coverage percent, missing days/hours, time range.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "label_join(mdp_coverage_percent, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "label_join(mdp_coverage_missing_days_total, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "label_join(mdp_coverage_missing_hours_total, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "label_join(mdp_coverage_first_timestamp_seconds * 1000, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "label_join(mdp_coverage_last_timestamp_seconds * 1000, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "dataset", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "service": true,
              "category": true,
              "symbol": true,
              "category 1": true,
              "category 2": true,
              "category 3": true,
              "category 4": true,
              "category 5": true,
              "symbol 1": true,
              "symbol 2": true,
              "symbol 3": true,
              "symbol 4": true,
              "symbol 5": true
            },
            "indexByName": {
              "dataset": 0,
              "Coverage %": 1,
              "Missing Days": 2,
              "Missing Hours": 3,
              "First Event": 4,
              "Last Event": 5
            },
            "renameByName": {
              "Value #A": "Coverage %",
              "Value #B": "Missing Days",
              "Value #C": "Missing Hours",
              "Value #D": "First Event",
              "Value #E": "Last Event",
              "dataset": "Dataset"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Coverage %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 95 },
                    { "color": "green", "value": 99 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "First Event" },
            "properties": [{ "id": "unit", "value": "dateTimeAsIso" }]
          },
          {
            "matcher": { "id": "byName", "options": "Last Event" },
            "properties": [{ "id": "unit", "value": "dateTimeAsIso" }]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Coverage %", "desc": false }] }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Coverage % — $category / $symbol",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_coverage_percent{category=\"$category\", symbol=\"$symbol\"}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Missing Days",
      "gridPos": { "x": 6, "y": 8, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_coverage_missing_days_total{category=\"$category\", symbol=\"$symbol\"}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Missing Hours",
      "gridPos": { "x": 10, "y": 8, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_coverage_missing_hours_total{category=\"$category\", symbol=\"$symbol\"}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "First Event",
      "gridPos": { "x": 14, "y": 8, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_coverage_first_timestamp_seconds{category=\"$category\", symbol=\"$symbol\"} * 1000",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last Event",
      "gridPos": { "x": 19, "y": 8, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_coverage_last_timestamp_seconds{category=\"$category\", symbol=\"$symbol\"} * 1000",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Missing Data",
      "description": "Datasets with missing days or hours.",
      "gridPos": { "x": 6, "y": 11, "w": 18, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "label_join(mdp_coverage_missing_days_total, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "label_join(mdp_coverage_missing_hours_total, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "label_join(mdp_coverage_percent, \"dataset\", \"/\", \"category\", \"symbol\")",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "dataset", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "service": true,
              "category": true,
              "symbol": true,
              "category 1": true,
              "category 2": true,
              "category 3": true,
              "symbol 1": true,
              "symbol 2": true,
              "symbol 3": true
            },
            "renameByName": {
              "Value #A": "Missing Days",
              "Value #B": "Missing Hours",
              "Value #C": "Coverage %",
              "dataset": "Dataset"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Missing Days",
                "config": { "id": "greater", "options": { "value": 0 } }
              },
              {
                "fieldName": "Missing Hours",
                "config": { "id": "greater", "options": { "value": 0 } }
              }
            ],
            "match": "any",
            "type": "include"
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Coverage %" },
            "properties": [{ "id": "unit", "value": "percent" }]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Day Coverage — $category / $symbol",
      "description": "Calendar view: 1 = full day coverage, 0 = gaps.",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_coverage_day_present{category=\"$category\", symbol=\"$symbol\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "category": true,
              "instance": true,
              "job": true,
              "service": true,
              "symbol": true
            },
            "renameByName": { "Value": "Status", "day": "Day" }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Day", "desc": true }] } }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "Gaps", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Hour Coverage — $day",
      "description": "Hourly heatmap row: OK = data present, Gaps = missing hour.",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mdp_coverage_hour_present{category=\"$category\", symbol=\"$symbol\", day=\"$day\"}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "category": true,
              "day": true,
              "instance": true,
              "job": true,
              "service": true,
              "symbol": true
            },
            "renameByName": { "Value": "Status", "hour": "Hour" }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Hour", "desc": false }]
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "Gaps", "color": "red" },
                      "1": { "text": "OK", "color": "green" }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    }
  ],
  "annotations": { "list": [] }
}
